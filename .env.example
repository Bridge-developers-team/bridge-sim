# Pick ONE AI provider. Without any key the app runs in demo mode (fixed sample output).
# Anthropic (Claude): https://console.anthropic.com/
ANTHROPIC_API_KEY=
# DeepSeek: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# Optional: force a provider (anthropic | deepseek | demo) and/or a model.
# Defaults: claude-opus-5-5 for anthropic, deepseek-flash for deepseek.
# LLM_PROVIDER=deepseek
# BRIDGE_MODEL=deepseek-v4-pro
PORT=3000
