# Copy to backend/.env for local runs. Never commit .env.
# Without a key the app runs in demo mode (labeled sample data, no AI).
ANTHROPIC_API_KEY=
# LLM_PROVIDER=demo            # force demo mode even with a key
# BRIDGE_MODEL=claude-sonnet-5-5
# BRIDGE_MODEL_FAST=claude-haiku-5-5
# Local default is SQLite in backend/bridge.db. Production: Neon Postgres URL.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
SECRET_KEY=change-me-to-a-long-random-string
# AI_CALLS_PER_CLIENT=40       # per visitor per 10 minutes
# AI_CALLS_PER_DAY=400         # hard daily cap on live AI calls
# ADZUNA_APP_ID=               # optional: live job listings (developer.adzuna.com)
# ADZUNA_APP_KEY=
